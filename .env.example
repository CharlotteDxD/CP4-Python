# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser commitado (já está no .gitignore).

FLASK_ENV=development
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# String de conexão do Postgres (Render/Railway). Formato:
# postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Chave da API do LLM usada por Anthony na categorização e nas recomendações
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Opcional: só é lido em modo "testing"; se não definir, os testes usam
# SQLite em memória automaticamente.
# TEST_DATABASE_URL=sqlite:///:memory:
